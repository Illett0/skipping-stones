# オンラインランキングを使う場合のみ設定してください（未設定ならランキングはブラウザ内に保存されます）
# ここには例だけを書きます。本物の値は .env.local（Git に含めない）か Vercel の環境変数に設定してください。

# ブラウザにも渡る値（公開されても問題ない）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# サーバー専用の値（絶対に NEXT_PUBLIC_ を付けない・公開しない）
# Supabase の service_role キー。記録の書き込みをサーバーだけが行うために使う
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# 記録の署名用の秘密の文字列（32 文字以上のランダムな値）
SCORE_SIGNING_SECRET=generate-a-random-string-of-32-or-more-characters
